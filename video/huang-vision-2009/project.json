 "captions": [
  {
   "start": 0.5,
   "end": 1.85,
   "text": "Năm 1993,"
  },
  {
   "start": 2.07,
   "end": 3.1,
   "text": "giới đầu tư bảo ông:"
  },
  {
   "start": 3.26,
   "end": 4.6,
   "text": "thị trường game không tồn tại."
  },
  {
   "start": 4.88,
   "end": 5.75,
   "text": "Mẹ ông thì hỏi:"
  },
  {
   "start": 5.92,
   "end": 7.25,
   "text": "sao không đi làm thuê?"
  },
  {
   "start": 7.48,
   "end": 9.25,
   "text": "Mười sáu năm sau, ở Stanford,"
  },
  {
   "start": 9.42,
   "end": 10.45,
   "text": "Jensen Huang chia sẻ cách ông"
  },
  {
   "start": 10.45,
   "end": 11.75,
   "text": "vượt qua điều đó."
  },
  {
   "start": 11.91,
   "end": 12.85,
   "text": "Bài học đầu tiên:"
  },
  {
   "start": 12.97,
   "end": 14.55,
   "text": "đừng chờ tầm nhìn vĩ đại."
  },
  {
   "start": 14.73,
   "end": 16.1,
   "text": "Ai cũng có một góc nhìn riêng,"
  },
  {
   "start": 16.2,
   "end": 17.65,
   "text": "và tầm nhìn chỉ là vậy."
  },
  {
   "start": 18.0,
   "end": 20.2,
   "text": "Góc nhìn của ông năm 1993:"
  },
  {
   "start": 20.26,
   "end": 21.35,
   "text": "lấy đồ họa ba chiều"
  },
  {
   "start": 21.35,
   "end": 22.45,
   "text": "từ những máy trạm đắt tiền,"
  },
  {
   "start": 22.54,
   "end": 23.55,
   "text": "làm cho thật rẻ,"
  },
  {
   "start": 23.62,
   "end": 24.55,
   "text": "và để trò chơi điện tử"
  },
  {
   "start": 24.55,
   "end": 26.05,
   "text": "kéo cả thị trường đi lên."
  },
  {
   "start": 26.42,
   "end": 27.2,
   "text": "Bài học thứ hai:"
  },
  {
   "start": 27.2,
   "end": 28.9,
   "text": "có lúc phải đi ngược khách hàng."
  },
  {
   "start": 29.09,
   "end": 30.75,
   "text": "Dell, HP, IBM,"
  },
  {
   "start": 30.86,
   "end": 32.95,
   "text": "Gateway đều chê sản phẩm quá đắt."
  },
  {
   "start": 33.09,
   "end": 34.7,
   "text": "Ông vẫn dồn mấy triệu đô cuối cùng"
  },
  {
   "start": 34.7,
   "end": 35.85,
   "text": "vào một con chip quá lớn,"
  },
  {
   "start": 35.93,
   "end": 37.85,
   "text": "vì tin công nghệ sẽ rẻ đi rất nhanh."
  },
  {
   "start": 38.27,
   "end": 39.63,
   "text": "Từng có khoảng hai trăm công ty"
  },
  {
   "start": 39.63,
   "end": 40.6,
   "text": "làm đồ họa ba chiều."
  },
  {
   "start": 40.72,
   "end": 41.81,
   "text": "Tiền, người, công nghệ"
  },
  {
   "start": 41.81,
   "end": 43.0,
   "text": "gần như ngang nhau."
  },
  {
   "start": 43.14,
   "end": 43.75,
   "text": "Theo ông,"
  },
  {
   "start": 43.82,
   "end": 44.86,
   "text": "ai sống sót là nhờ hiểu"
  },
  {
   "start": 44.86,
   "end": 45.91,
   "text": "vì sao việc kinh doanh"
  },
  {
   "start": 45.91,
   "end": 46.85,
   "text": "của mình chạy được."
  },
  {
   "start": 47.1,
   "end": 47.9,
   "text": "Bài học thứ ba:"
  },
  {
   "start": 47.9,
   "end": 49.6,
   "text": "tập quen với sự mơ hồ."
  },
  {
   "start": 49.82,
   "end": 51.3,
   "text": "Người lãnh đạo không cần hướng ngoại,"
  },
  {
   "start": 51.37,
   "end": 52.09,
   "text": "nhưng phải dám làm"
  },
  {
   "start": 52.09,
   "end": 53.55,
   "text": "khi chưa thấy hết kết quả."
  },
  {
   "start": 53.78,
   "end": 54.7,
   "text": "Bài học thứ tư:"
  },
  {
   "start": 54.87,
   "end": 56.05,
   "text": "tự đập đi xây lại."
  },
  {
   "start": 56.24,
   "end": 57.09,
   "text": "Thứ gì thành công rồi"
  },
  {
   "start": 57.09,
   "end": 57.95,
   "text": "cũng phải làm lại,"
  },
  {
   "start": 58.06,
   "end": 59.35,
   "text": "khoảng mười năm một lần."
  },
  {
   "start": 59.6,
   "end": 60.56,
   "text": "Nếu bạn không tự thay thế"
  },
  {
   "start": 60.56,
   "end": 61.35,
   "text": "sản phẩm của mình,"
  },
  {
   "start": 61.48,
   "end": 62.85,
   "text": "đối thủ sẽ làm thay."
  },
  {
   "start": 63.1,
   "end": 63.65,
   "text": "Cuối cùng:"
  },
  {
   "start": 63.79,
   "end": 64.8,
   "text": "kỹ năng, trí tuệ, đào tạo"
  },
  {
   "start": 64.9,
   "end": 66.85,
   "text": "đều quan trọng, nhưng chưa đủ."
  },
  {
   "start": 67.02,
   "end": 68.21,
   "text": "Phải đam mê cả phần đau đớn"
  },
  {
   "start": 68.21,
   "end": 69.35,
   "text": "của việc xây công ty."
  },
  {
   "start": 69.54,
   "end": 70.75,
   "text": "Bạn đang thiếu bài học nào?"
  },
  {
   "start": 70.88,
   "end": 72.25,
   "text": "Bình luận cho mình biết nhé."
  }
 ],
