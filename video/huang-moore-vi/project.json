 "captions": [
  {
   "start": 0.44,
   "end": 1.73,
   "text": "Năm 2009,"
  },
  {
   "start": 1.75,
   "end": 3.69,
   "text": "khi AI còn chưa bùng nổ,"
  },
  {
   "start": 3.71,
   "end": 5.066,
   "text": "thông điệp của Jensen Huang"
  },
  {
   "start": 5.086,
   "end": 6.08,
   "text": "ở Stanford là:"
  },
  {
   "start": 6.1,
   "end": 7.53,
   "text": "đừng chỉ nghe khách hàng."
  },
  {
   "start": 7.62,
   "end": 9.19,
   "text": "Hãy nghe Định luật Moore."
  },
  {
   "start": 9.81,
   "end": 10.945,
   "text": "Định luật Moore dự đoán"
  },
  {
   "start": 10.965,
   "end": 12.101,
   "text": "số transistor trên chip"
  },
  {
   "start": 12.121,
   "end": 12.855,
   "text": "sẽ tăng gấp đôi"
  },
  {
   "start": 12.875,
   "end": 14.38,
   "text": "sau mỗi khoảng hai năm."
  },
  {
   "start": 14.69,
   "end": 16.218,
   "text": "Hầu hết công ty dùng quy luật này"
  },
  {
   "start": 16.238,
   "end": 17.48,
   "text": "để dự báo kỹ thuật."
  },
  {
   "start": 17.67,
   "end": 18.486,
   "text": "Jensen dùng nó"
  },
  {
   "start": 18.506,
   "end": 20.05,
   "text": "để dự báo tương lai."
  },
  {
   "start": 20.64,
   "end": 21.67,
   "text": "Thập niên 90,"
  },
  {
   "start": 21.69,
   "end": 23.58,
   "text": "khách hàng chỉ muốn game đẹp hơn."
  },
  {
   "start": 23.8,
   "end": 25.377,
   "text": "Nhưng NVIDIA liên tục làm GPU"
  },
  {
   "start": 25.397,
   "end": 26.369,
   "text": "mạnh gấp nhiều lần"
  },
  {
   "start": 26.389,
   "end": 27.62,
   "text": "nhu cầu thực tế."
  },
  {
   "start": 27.89,
   "end": 29.33,
   "text": "Khách hàng chê quá đắt."
  },
  {
   "start": 29.45,
   "end": 30.74,
   "text": "Jensen thì nghĩ:"
  },
  {
   "start": 30.97,
   "end": 31.995,
   "text": "Khi sức mạnh tính toán"
  },
  {
   "start": 32.015,
   "end": 33.03,
   "text": "tăng đủ nhanh,"
  },
  {
   "start": 33.06,
   "end": 34.208,
   "text": "những ứng dụng hoàn toàn mới"
  },
  {
   "start": 34.228,
   "end": 35.12,
   "text": "sẽ xuất hiện."
  },
  {
   "start": 35.55,
   "end": 37.24,
   "text": "Ông đặt cược vào GPU."
  },
  {
   "start": 37.34,
   "end": 38.8,
   "text": "Sau đó là CUDA."
  },
  {
   "start": 38.86,
   "end": 40.27,
   "text": "Sau đó là AI."
  },
  {
   "start": 40.51,
   "end": 41.56,
   "text": "15 năm sau,"
  },
  {
   "start": 41.58,
   "end": 43.095,
   "text": "cả thế giới chạy đua xây AI"
  },
  {
   "start": 43.115,
   "end": 45.0,
   "text": "bằng chính con chip NVIDIA."
  },
  {
   "start": 45.61,
   "end": 47.42,
   "text": "Bài học lớn nhất từ Jensen Huang:"
  },
  {
   "start": 47.67,
   "end": 49.31,
   "text": "Khách hàng nói về hiện tại."
  },
  {
   "start": 49.47,
   "end": 51.1,
   "text": "Công nghệ nói về tương lai."
  },
  {
   "start": 51.36,
   "end": 52.49,
   "text": "Những công ty vĩ đại"
  },
  {
   "start": 52.51,
   "end": 54.1,
   "text": "không chỉ dự đoán nhu cầu."
  },
  {
   "start": 54.15,
   "end": 55.475,
   "text": "Họ dự đoán nơi mà công nghệ"
  },
  {
   "start": 55.495,
   "end": 57.04,
   "text": "sẽ đưa nhân loại đến tiếp theo."
  }
 ],
