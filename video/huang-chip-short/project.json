 "captions": [
  {
   "start": 0.4,
   "end": 1.91,
   "text": "Nvidia's Jensen Huang"
  },
  {
   "start": 1.91,
   "end": 3.05,
   "text": "just resigned."
  },
  {
   "start": 3.46,
   "end": 4.4,
   "text": "The headlines say:"
  },
  {
   "start": 4.64,
   "end": 5.89,
   "text": "a reported affair,"
  },
  {
   "start": 6.18,
   "end": 8.05,
   "text": "and a woman U.S. officials"
  },
  {
   "start": 8.21,
   "end": 9.39,
   "text": "call a Chinese spy."
  },
  {
   "start": 9.88,
   "end": 10.58,
   "text": "But rewind."
  },
  {
   "start": 11.02,
   "end": 12.35,
   "text": "In 2022,"
  },
  {
   "start": 12.71,
   "end": 14.85,
   "text": "Washington banned his best AI chips"
  },
  {
   "start": 14.85,
   "end": 15.59,
   "text": "from China."
  },
  {
   "start": 15.85,
   "end": 16.73,
   "text": "So Huang built"
  },
  {
   "start": 16.73,
   "end": 18.24,
   "text": "a weaker chip for China."
  },
  {
   "start": 18.57,
   "end": 19.8,
   "text": "In 2025,"
  },
  {
   "start": 20.05,
   "end": 21.03,
   "text": "that was banned too."
  },
  {
   "start": 21.61,
   "end": 22.65,
   "text": "So he went to Trump,"
  },
  {
   "start": 22.82,
   "end": 23.59,
   "text": "and made a deal:"
  },
  {
   "start": 23.98,
   "end": 24.8,
   "text": "sell the chips,"
  },
  {
   "start": 24.8,
   "end": 26.46,
   "text": "and give the government a cut."
  },
  {
   "start": 26.78,
   "end": 28.08,
   "text": "First fifteen percent."
  },
  {
   "start": 28.39,
   "end": 29.31,
   "text": "Then twenty-five."
  },
  {
   "start": 29.71,
   "end": 31.2,
   "text": "China hawks hated it."
  },
  {
   "start": 31.71,
   "end": 33.71,
   "text": "Then, in October 2026,"
  },
  {
   "start": 33.88,
   "end": 34.7,
   "text": "U.S. officials told"
  },
  {
   "start": 34.7,
   "end": 35.65,
   "text": "the New York Times"
  },
  {
   "start": 35.65,
   "end": 36.55,
   "text": "about the relationship"
  },
  {
   "start": 36.55,
   "end": 37.57,
   "text": "and the spy claim."
  },
  {
   "start": 38.11,
   "end": 39.65,
   "text": "Beijing calls it fabrication."
  },
  {
   "start": 40.16,
   "end": 40.86,
   "text": "Two weeks later,"
  },
  {
   "start": 41.02,
   "end": 41.72,
   "text": "he was out."
  },
  {
   "start": 42.18,
   "end": 43.65,
   "text": "A real security risk?"
  },
  {
   "start": 43.65,
   "end": 45.18,
   "text": "Or a dealmaker removed?"
  },
  {
   "start": 45.62,
   "end": 46.85,
   "text": "The public has not seen"
  },
  {
   "start": 46.85,
   "end": 47.4,
   "text": "the evidence."
  },
  {
   "start": 47.76,
   "end": 48.44,
   "text": "What do you think?"
  }
 ],
