 "captions": [
  {
   "start": 0.45,
   "end": 2.25,
   "text": "Who really builds a building?"
  },
  {
   "start": 2.35,
   "end": 4.35,
   "text": "Not just the crew with the hammers."
  },
  {
   "start": 4.45,
   "end": 6.1,
   "text": "It starts with one owner,"
  },
  {
   "start": 6.17,
   "end": 7.4,
   "text": "one empty plot,"
  },
  {
   "start": 7.46,
   "end": 9.2,
   "text": "and one big idea."
  },
  {
   "start": 9.31,
   "end": 12.5,
   "text": "Most people think design is just pretty drawings."
  },
  {
   "start": 12.56,
   "end": 14.6,
   "text": "But every line has a price:"
  },
  {
   "start": 14.69,
   "end": 15.98,
   "text": "the designer draws it,"
  },
  {
   "start": 16.05,
   "end": 18.4,
   "text": "and the QS counts its cost."
  },
  {
   "start": 18.68,
   "end": 20.3,
   "text": "Then come the hidden gates:"
  },
  {
   "start": 20.44,
   "end": 21.7,
   "text": "government approvals,"
  },
  {
   "start": 21.79,
   "end": 24.2,
   "text": "and a tender where contractors compete."
  },
  {
   "start": 24.29,
   "end": 25.51,
   "text": "And the lowest price"
  },
  {
   "start": 25.51,
   "end": 27.85,
   "text": "is not always the best value."
  },
  {
   "start": 28.05,
   "end": 30.28,
   "text": "On site, the contractor builds,"
  },
  {
   "start": 30.36,
   "end": 31.9,
   "text": "while the supervision consultant"
  },
  {
   "start": 31.97,
   "end": 34.05,
   "text": "checks every pour and every bolt"
  },
  {
   "start": 34.11,
   "end": 35.95,
   "text": "against the approved drawings."
  },
  {
   "start": 36.09,
   "end": 37.4,
   "text": "Here is the truth:"
  },
  {
   "start": 37.47,
   "end": 40.55,
   "text": "a project never succeeds because of one hero."
  },
  {
   "start": 40.66,
   "end": 42.5,
   "text": "It succeeds when six parties"
  },
  {
   "start": 42.51,
   "end": 44.4,
   "text": "keep their promises to each other."
  },
  {
   "start": 44.53,
   "end": 45.98,
   "text": "Inspections pass,"
  },
  {
   "start": 46.11,
   "end": 47.58,
   "text": "the keys change hands,"
  },
  {
   "start": 47.65,
   "end": 50.35,
   "text": "and an idea becomes a place for people."
  },
  {
   "start": 50.45,
   "end": 51.9,
   "text": "Which role matters most?"
  },
  {
   "start": 52.01,
   "end": 53.7,
   "text": "Tell us in the comments."
  }
 ],
