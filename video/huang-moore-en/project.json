 "captions": [
  {
   "start": 0.41,
   "end": 1.58,
   "text": "2009."
  },
  {
   "start": 1.63,
   "end": 3.48,
   "text": "AI hasn't taken off yet."
  },
  {
   "start": 3.5,
   "end": 4.703,
   "text": "Jensen Huang's message"
  },
  {
   "start": 4.723,
   "end": 5.74,
   "text": "at Stanford:"
  },
  {
   "start": 5.79,
   "end": 7.455,
   "text": "don't just listen to customers."
  },
  {
   "start": 7.475,
   "end": 9.02,
   "text": "Listen to Moore's Law."
  },
  {
   "start": 9.18,
   "end": 9.792,
   "text": "Moore's Law:"
  },
  {
   "start": 9.812,
   "end": 11.107,
   "text": "the number of transistors"
  },
  {
   "start": 11.127,
   "end": 11.581,
   "text": "on a chip"
  },
  {
   "start": 11.601,
   "end": 13.48,
   "text": "doubles about every two years."
  },
  {
   "start": 13.5,
   "end": 14.619,
   "text": "Most companies used it"
  },
  {
   "start": 14.639,
   "end": 16.15,
   "text": "to forecast technology."
  },
  {
   "start": 16.17,
   "end": 16.88,
   "text": "Jensen used it"
  },
  {
   "start": 16.9,
   "end": 18.45,
   "text": "to forecast the future."
  },
  {
   "start": 18.58,
   "end": 20.03,
   "text": "The 1990s."
  },
  {
   "start": 20.05,
   "end": 20.915,
   "text": "Gamers just wanted"
  },
  {
   "start": 20.935,
   "end": 22.07,
   "text": "prettier graphics."
  },
  {
   "start": 22.09,
   "end": 23.075,
   "text": "NVIDIA built GPUs"
  },
  {
   "start": 23.095,
   "end": 24.08,
   "text": "far more powerful"
  },
  {
   "start": 24.1,
   "end": 25.67,
   "text": "than anyone asked for."
  },
  {
   "start": 25.69,
   "end": 27.51,
   "text": "Customers said it cost too much."
  },
  {
   "start": 27.53,
   "end": 28.8,
   "text": "Jensen saw it differently:"
  },
  {
   "start": 28.82,
   "end": 29.492,
   "text": "Give the world"
  },
  {
   "start": 29.512,
   "end": 30.629,
   "text": "enough computing power,"
  },
  {
   "start": 30.649,
   "end": 32.63,
   "text": "and new applications will appear."
  },
  {
   "start": 32.68,
   "end": 34.3,
   "text": "He bet on the GPU."
  },
  {
   "start": 34.32,
   "end": 35.18,
   "text": "Then CUDA."
  },
  {
   "start": 35.2,
   "end": 36.24,
   "text": "Then AI."
  },
  {
   "start": 36.26,
   "end": 37.434,
   "text": "Fifteen years later,"
  },
  {
   "start": 37.454,
   "end": 39.285,
   "text": "the world is racing to build AI"
  },
  {
   "start": 39.305,
   "end": 40.61,
   "text": "on NVIDIA chips."
  },
  {
   "start": 40.65,
   "end": 42.19,
   "text": "Jensen's big lesson:"
  },
  {
   "start": 42.24,
   "end": 42.78,
   "text": "Customers talk"
  },
  {
   "start": 42.8,
   "end": 43.77,
   "text": "about the present."
  },
  {
   "start": 43.79,
   "end": 44.483,
   "text": "Technology talks"
  },
  {
   "start": 44.503,
   "end": 45.52,
   "text": "about the future."
  },
  {
   "start": 45.54,
   "end": 46.27,
   "text": "Great companies"
  },
  {
   "start": 46.29,
   "end": 47.79,
   "text": "don't just predict demand."
  },
  {
   "start": 47.81,
   "end": 49.125,
   "text": "They predict where technology"
  },
  {
   "start": 49.145,
   "end": 49.79,
   "text": "takes us next."
  }
 ],
