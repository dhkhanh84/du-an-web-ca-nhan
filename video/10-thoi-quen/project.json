 "captions": [
  {
   "start": 0.5,
   "end": 1.86,
   "text": "Mười thói quen nhỏ,"
  },
  {
   "start": 1.88,
   "end": 3.84,
   "text": "giúp bạn khỏe hơn mỗi ngày."
  },
  {
   "start": 4.33,
   "end": 6.8,
   "text": "Một, bớt xem tin tức tiêu cực."
  },
  {
   "start": 7.26,
   "end": 10.05,
   "text": "Hai, đi ngủ trước mười một giờ đêm."
  },
  {
   "start": 10.53,
   "end": 13.03,
   "text": "Ba, để điện thoại xa giường ngủ."
  },
  {
   "start": 13.51,
   "end": 15.23,
   "text": "Bốn, mỗi ngày dành vài phút"
  },
  {
   "start": 15.25,
   "end": 17.27,
   "text": "hít thở sâu và chậm."
  },
  {
   "start": 17.86,
   "end": 20.01,
   "text": "Năm, đi bộ ba mươi phút,"
  },
  {
   "start": 20.03,
   "end": 21.59,
   "text": "tốt nhất là ngoài trời."
  },
  {
   "start": 22.12,
   "end": 23.43,
   "text": "Sáu, phơi nắng"
  },
  {
   "start": 23.45,
   "end": 24.96,
   "text": "mười đến mười lăm phút."
  },
  {
   "start": 25.47,
   "end": 27.39,
   "text": "Bảy, ăn bớt đồ ngọt."
  },
  {
   "start": 27.99,
   "end": 30.31,
   "text": "Tám, giữ nhà cửa gọn gàng."
  },
  {
   "start": 30.82,
   "end": 32.55,
   "text": "Chín, không tranh cãi,"
  },
  {
   "start": 32.57,
   "end": 33.85,
   "text": "nhất là trên mạng."
  },
  {
   "start": 34.44,
   "end": 35.53,
   "text": "Mười, trò chuyện"
  },
  {
   "start": 35.55,
   "end": 37.41,
   "text": "với người thân và bạn bè."
  },
  {
   "start": 38.03,
   "end": 39.65,
   "text": "Chỉ cần làm được vài điều,"
  },
  {
   "start": 39.67,
   "end": 41.64,
   "text": "cơ thể cũng sẽ biết ơn bạn."
  },
  {
   "start": 42.16,
   "end": 43.99,
   "text": "Bạn đang làm được mấy điều rồi?"
  },
  {
   "start": 44.01,
   "end": 45.84,
   "text": "Bình luận cho mình biết nhé."
  }
 ],
