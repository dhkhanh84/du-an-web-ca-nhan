  {
   "start": 0.15,
   "end": 1.83,
   "text": "One wrong answer."
  },
  {
   "start": 1.85,
   "end": 3.38,
   "text": "Out of one hundred sixty."
  },
  {
   "start": 3.4,
   "end": 4.73,
   "text": "That was the first-round score"
  },
  {
   "start": 4.75,
   "end": 6.18,
   "text": "of this year's top candidate"
  },
  {
   "start": 6.2,
   "end": 7.43,
   "text": "on South Korea's"
  },
  {
   "start": 7.45,
   "end": 9.51,
   "text": "tax accountant exam."
  },
  {
   "start": 9.54,
   "end": 10.43,
   "text": "When people suspected"
  },
  {
   "start": 10.45,
   "end": 11.33,
   "text": "AI glasses,"
  },
  {
   "start": 11.35,
   "end": 12.97,
   "text": "he denied it."
  },
  {
   "start": 12.99,
   "end": 14.82,
   "text": "Days later, he confessed."
  },
  {
   "start": 15.25,
   "end": 16.53,
   "text": "According to his confession,"
  },
  {
   "start": 16.55,
   "end": 17.73,
   "text": "a tiny camera"
  },
  {
   "start": 17.75,
   "end": 19.38,
   "text": "photographed the questions,"
  },
  {
   "start": 19.4,
   "end": 21.03,
   "text": "an AI app solved them,"
  },
  {
   "start": 21.05,
   "end": 22.13,
   "text": "and he read the answers"
  },
  {
   "start": 22.15,
   "end": 23.33,
   "text": "on a hidden device,"
  },
  {
   "start": 23.35,
   "end": 24.61,
   "text": "during the exam."
  },
  {
   "start": 24.66,
   "end": 26.03,
   "text": "He says he did the same"
  },
  {
   "start": 26.05,
   "end": 28.11,
   "text": "in both rounds of the tax exam,"
  },
  {
   "start": 28.13,
   "end": 29.03,
   "text": "and in the first round"
  },
  {
   "start": 29.05,
   "end": 30.49,
   "text": "of the CPA exam."
  },
  {
   "start": 30.92,
   "end": 32.43,
   "text": "Police have seized the camera,"
  },
  {
   "start": 32.45,
   "end": 34.03,
   "text": "and the government is reviewing"
  },
  {
   "start": 34.05,
   "end": 34.83,
   "text": "this year's national"
  },
  {
   "start": 34.85,
   "end": 36.38,
   "text": "certification exams."
  },
  {
   "start": 36.66,
   "end": 37.88,
   "text": "The camera reportedly cost"
  },
  {
   "start": 37.9,
   "end": 39.49,
   "text": "about eighty dollars."
  },
  {
   "start": 39.51,
   "end": 41.03,
   "text": "So when AI can answer"
  },
  {
   "start": 41.05,
   "end": 42.03,
   "text": "almost any question,"
  },
  {
   "start": 42.05,
   "end": 44.53,
   "text": "how should exams change?"
  },
  {
   "start": 44.6,
   "end": 46.08,
   "text": "Tell us in the comments."
  }
 ],
